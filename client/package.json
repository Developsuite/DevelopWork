  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "cap": "node --require ./scripts/node-userinfo-fallback.cjs ./node_modules/@capacitor/cli/bin/capacitor",
