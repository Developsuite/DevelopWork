# Google OAuth web client credentials (never expose these in Vite/client env files)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Must exactly match an authorized redirect URI in Google Cloud Console.
GOOGLE_REDIRECT_URI=https://YOUR_PROJECT_REF.supabase.co/functions/v1/google-calendar/callback

# Generate with: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-key

# Frontend origin used after OAuth completes. No trailing slash.
APP_URL=http://localhost:5173
